{
	"name": "mcpx",
	"version": "0.12.2",
	"license": "MIT",
	"bin": {
		"mcpx": "./src/main.ts"
	},
	"type": "module",
	"scripts": {
		"build": "./scripts/build.sh",
		"check": "bun run typecheck && bun test && bunx oxfmt --check package.json tsconfig.json README.md .gitignore .oxfmtrc.json src tests skills docs",
		"format": "bunx oxfmt package.json tsconfig.json README.md .gitignore .oxfmtrc.json src tests skills docs",
		"prototype:cancellation": "bun prototypes/mcp-cancellation/run.ts",
		"prototype:cancellation:evidence": "bun prototypes/mcp-cancellation/run.ts --evidence",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@celados/argc": "^7.11.0",
		"@clack/prompts": "^1.2.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@valibot/to-json-schema": "^1.6.0",
		"valibot": "^1.3.1",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.12",
		"oxfmt": "^0.46.0",
		"typescript": "^7.0.2"
	}
}
